# Copie para .env.local e preencha o que for usar.

# --- IA (conversa no Desabafar) ---
# Sem esta chave, a conversa com IA fica desligada (o chat avisa e não gera respostas).
# Crie uma chave em https://console.anthropic.com/ (Settings > API Keys). Fica só no servidor.
# Depois de preencher: npm run ia:verificar
ANTHROPIC_API_KEY=

# Modelo usado na conversa. Padrão: claude-opus-5-5.
# Para reduzir custo, dá para usar claude-sonnet-5-5 ou claude-haiku-5-5.
AI_MODEL=

# --- Banco de dados ---
# Caminho do arquivo SQLite. Padrão: ./data/vunimo.db
DATABASE_PATH=
